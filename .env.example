SA_PASSWORD=
SA_USER=sa
DB_NAME=AutoAlertDB
SCRIPT_PATH=/usr/src/app/scriptAutoAlertDB.sql
MSSQL_PID=Developer
 
# JWT configuration required by the backend
JWT_KEY=
JWT_ISSUER=
JWT_AUDIENCE=

# Resend (el dominio del remitente debe estar verificado en Resend)
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=AutoAlert

# Twilio (números E.164; para WhatsApp se acepta +1415... o whatsapp:+1415...)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
